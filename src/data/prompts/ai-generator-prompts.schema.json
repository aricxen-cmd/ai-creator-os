{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Generator Prompt Database",
  "type": "object",
  "required": [
    "schema_version",
    "prompt_templates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "style_presets": {
      "type": "array"
    },
    "prompt_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prompt_template"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "default_model": {
            "type": "string"
          },
          "default_style": {
            "type": "string"
          },
          "aspect_ratio": {
            "type": "string"
          },
          "prompt_template": {
            "type": "string"
          },
          "negative_prompt": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}